/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU_US MENUEX
BEGIN
    POPUP "文件(&F)",                          0,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "载入游戏...(&L)\tCtrl+O",       ID_FILE_LOAD_GAME,MFT_STRING,MFS_ENABLED
        POPUP "最近的游戏(&G)",                  0,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "Dummy",                       ID_RECENT_DUMMY,MFT_STRING,MFS_GRAYED
        END
        MENUITEM "载入多卡带...",           ID_FILE_LOADMULTICART,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        POPUP "保存游戏进度(&S)",            ID_FILE_SAVE_POPUP,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM MFT_SEPARATOR
            MENUITEM "选择文件(&S)",                ID_FILE_SAVE_FILE,MFT_STRING,MFS_ENABLED
        END
        POPUP "读取游戏进度(&L)",            ID_FILE_LOAD_POPUP,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM MFT_SEPARATOR
            MENUITEM "Oops 文件",                   ID_FILE_LOAD_OOPS,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "选择文件(&S)",                ID_FILE_LOAD_FILE,MFT_STRING,MFS_ENABLED
        END
        MENUITEM "带预览保存(&S)",          ID_FILE_SAVE_PREVIEW,MFT_STRING,MFS_ENABLED
        MENUITEM "带预览载入(&L)",          ID_FILE_LOAD_PREVIEW,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        POPUP "保存其他",                     0,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "保存 SPC 数据(&S)",              ID_FILE_SAVE_SPC_DATA,MFT_STRING,MFS_ENABLED
            MENUITEM "保存截图",             ID_SAVESCREENSHOT,MFT_STRING,MFS_ENABLED
            MENUITEM "保存 S-RAM 数据(&V)",            ID_FILE_SAVE_SRAM_DATA,MFT_STRING,MFS_ENABLED
            MENUITEM "保存内存卡",            ID_SAVEMEMPACK,MFT_STRING,MFS_ENABLED
        END
        MENUITEM "ROM 信息...(&R)",          IDM_ROM_INFO,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "播放录像...(&M)",               ID_FILE_MOVIE_PLAY,MFT_STRING,MFS_ENABLED
        MENUITEM "录制录像...(&M)",             ID_FILE_MOVIE_RECORD,MFT_STRING,MFS_ENABLED
        MENUITEM "停止录像",                  ID_FILE_MOVIE_STOP,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "AVI 录制",               ID_FILE_AVI_RECORDING,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "重置游戏(&R)",                 ID_FILE_RESET,MFT_STRING,MFS_ENABLED
        MENUITEM "退出(&X)\tAlt+F4",               ID_FILE_EXIT,MFT_STRING,MFS_ENABLED
    END
    POPUP "模拟(&E)",                     0,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "暂停(&P)",                      ID_FILE_PAUSE,MFT_STRING,MFS_ENABLED
        MENUITEM "不活动时暂停(&W)",        ID_EMULATION_PAUSEWHENINACTIVE,MFT_STRING,MFS_ENABLED
        MENUITEM "逐帧步进(&F)",              ID_FRAME_ADVANCE,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "Hacks...(&H)",                   ID_EMULATION_HACKS,MFT_STRING,MFS_ENABLED
        MENUITEM "设置...(&S)\tAlt+F8",        ID_OPTIONS_SETTINGS,MFT_STRING,MFS_ENABLED
    END
    POPUP "输入(&I)",                         0,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "输入配置...(&I)\tAlt+F7", 40022,MFT_STRING,MFS_ENABLED
        MENUITEM "自定义快捷键...(&C)\tAlt+F9", ID_OPTIONS_KEYCUSTOM,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "启用后台输入",     ID_EMULATION_BACKGROUNDINPUT,MFT_STRING,MFS_ENABLED
        MENUITEM "后台键盘快捷键", ID_INPUT_BACKGROUNDKEYBOARDHOTKEYS,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "检测手柄变化",      ID_INPUT_DETECTGAMEPADCHANGES,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "使用 SNES 手柄",          IDM_SNES_JOYPAD,MFT_STRING,MFS_ENABLED
        MENUITEM "使用 SNES 鼠标",              IDM_MOUSE_TOGGLE,MFT_STRING,MFS_ENABLED
        MENUITEM "使用 Super Scope",             IDM_SCOPE_TOGGLE,MFT_STRING,MFS_ENABLED
        MENUITEM "使用 Super Multitap（5 人）", IDM_ENABLE_MULTITAP,MFT_STRING,MFS_ENABLED
        MENUITEM "使用 Konami Justifier",        IDM_JUSTIFIER,MFT_STRING,MFS_ENABLED
        MENUITEM "使用 鼠标在备用端口", IDM_MOUSE_SWAPPED,MFT_STRING,MFS_ENABLED
        MENUITEM "使用 多分线器（8 人）",    IDM_MULTITAP8,MFT_STRING,MFS_ENABLED
        MENUITEM "使用 双 Justifier",         IDM_JUSTIFIERS,MFT_STRING,MFS_ENABLED
        MENUITEM "使用 M.A.C.S. 步枪",          IDM_MACSRIFLE_TOGGLE,MFT_STRING,MFS_ENABLED
    END
    POPUP "声音(&S)",                         0,MFT_STRING,MFS_ENABLED
    BEGIN
        POPUP "播放频率(&P)",                 0,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "静音(&M)",                 ID_SOUND_NOSOUND,MFT_STRING,MFS_ENABLED
            MENUITEM "8KHz",                        ID_SOUND_8000HZ,MFT_STRING,MFS_ENABLED
            MENUITEM "11KHz",                       ID_SOUND_11025HZ,MFT_STRING,MFS_ENABLED
            MENUITEM "16KHz",                       ID_SOUND_16000HZ,MFT_STRING,MFS_ENABLED
            MENUITEM "22KHz",                       ID_SOUND_22050HZ,MFT_STRING,MFS_ENABLED
            MENUITEM "30KHz",                       ID_SOUND_30000HZ,MFT_STRING,MFS_ENABLED
            MENUITEM "32KHz",                       ID_SOUND_32000HZ,MFT_STRING,MFS_ENABLED
            MENUITEM "35KHz",                       ID_SOUND_35000HZ,MFT_STRING,MFS_ENABLED
            MENUITEM "44KHz",                       ID_SOUND_44100HZ,MFT_STRING,MFS_ENABLED
            MENUITEM "48KHz",                       ID_SOUND_48000HZ,MFT_STRING,MFS_ENABLED
        END
        POPUP "缓冲长度(&B)",                 0,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "16ms",                        ID_SOUND_16MS,MFT_STRING,MFS_ENABLED
            MENUITEM "32ms",                        ID_SOUND_32MS,MFT_STRING,MFS_ENABLED
            MENUITEM "48ms",                        ID_SOUND_48MS,MFT_STRING,MFS_ENABLED
            MENUITEM "64ms",                        ID_SOUND_64MS,MFT_STRING,MFS_ENABLED
            MENUITEM "80ms",                        ID_SOUND_80MS,MFT_STRING,MFS_ENABLED
            MENUITEM "96ms",                        ID_SOUND_96MS,MFT_STRING,MFS_ENABLED
            MENUITEM "112ms",                       ID_SOUND_112MS,MFT_STRING,MFS_ENABLED
            MENUITEM "128ms",                       ID_SOUND_128MS,MFT_STRING,MFS_ENABLED
            MENUITEM "144ms",                       ID_SOUND_144MS,MFT_STRING,MFS_ENABLED
            MENUITEM "160ms",                       ID_SOUND_160MS,MFT_STRING,MFS_ENABLED
            MENUITEM "176ms",                       ID_SOUND_176MS,MFT_STRING,MFS_ENABLED
            MENUITEM "192ms",                       ID_SOUND_192MS,MFT_STRING,MFS_ENABLED
            MENUITEM "208ms",                       ID_SOUND_208MS,MFT_STRING,MFS_ENABLED
        END
        POPUP "声道(&C)",                      0,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "声道 &1",                  ID_CHANNELS_CHANNEL1,MFT_STRING,MFS_ENABLED
            MENUITEM "声道 &2",                  ID_CHANNELS_CHANNEL2,MFT_STRING,MFS_ENABLED
            MENUITEM "声道 &3",                  ID_CHANNELS_CHANNEL3,MFT_STRING,MFS_ENABLED
            MENUITEM "声道 &4",                  ID_CHANNELS_CHANNEL4,MFT_STRING,MFS_ENABLED
            MENUITEM "声道 &5",                  ID_CHANNELS_CHANNEL5,MFT_STRING,MFS_ENABLED
            MENUITEM "声道 &6",                  ID_CHANNELS_CHANNEL6,MFT_STRING,MFS_ENABLED
            MENUITEM "声道 &7",                  ID_CHANNELS_CHANNEL7,MFT_STRING,MFS_ENABLED
            MENUITEM "声道 &8",                  ID_CHANNELS_CHANNEL8,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "全部启用",                  ID_CHANNELS_ENABLEALL,MFT_STRING,MFS_ENABLED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "同步声音(&Y)\tAlt+]",          ID_SOUND_SYNC,MFT_STRING,MFS_ENABLED
        MENUITEM "设置...(&S)\tAlt+T",         ID_SOUND_OPTIONS,MFT_STRING,MFS_ENABLED
    END
    POPUP "视频(&V)",                         0,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "隐藏菜单栏(&H)\tEsc",          ID_WINDOW_HIDEMENUBAR,MFT_STRING,MFS_ENABLED
        MENUITEM "全屏(&F)\tAlt+Enter",     ID_WINDOW_FULLSCREEN,MFT_STRING,MFS_ENABLED
        POPUP "窗口大小(&W)",                   0,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&1x",                         ID_WINDOW_SIZE_1X,MFT_STRING,MFS_ENABLED
            MENUITEM "&2x",                         ID_WINDOW_SIZE_2X,MFT_STRING,MFS_ENABLED
            MENUITEM "&3x",                         ID_WINDOW_SIZE_3X,MFT_STRING,MFS_ENABLED
            MENUITEM "&4x",                         ID_WINDOW_SIZE_4X,MFT_STRING,MFS_ENABLED
            MENUITEM "&5x",                         ID_WINDOW_SIZE_5X,MFT_STRING,MFS_ENABLED
            MENUITEM "&6x",                         ID_WINDOW_SIZE_6X,MFT_STRING,MFS_ENABLED
            MENUITEM "&7x",                         ID_WINDOW_SIZE_7X,MFT_STRING,MFS_ENABLED
            MENUITEM "&8x",                         ID_WINDOW_SIZE_8X,MFT_STRING,MFS_ENABLED
            MENUITEM "&9x",                         ID_WINDOW_SIZE_9X,MFT_STRING,MFS_ENABLED
            MENUITEM "1&0x",                        ID_WINDOW_SIZE_10X,MFT_STRING,MFS_ENABLED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "拉伸图像(&S)\tAlt+Backspace", ID_WINDOW_STRETCH,MFT_STRING,MFS_ENABLED
        MENUITEM "保持宽高比(&M)",      ID_WINDOW_ASPECTRATIO,MFT_STRING,MFS_ENABLED
        MENUITEM "双线性过滤(&B)",         ID_WINDOW_BILINEAR,MFT_STRING,MFS_ENABLED
        MENUITEM "显示帧率(&R)",            ID_VIDEO_SHOWFRAMERATE,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "显示配置...(&D)\tAlt+F5", ID_OPTIONS_DISPLAY,MFT_STRING,MFS_ENABLED
    END
    POPUP "金手指(&C)",                         0,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "金手指 GG、PAR (&G)", ID_CHEAT_ENTER,MFT_STRING,MFS_ENABLED
        MENUITEM "搜索新金手指(&S)",      ID_CHEAT_SEARCH,MFT_STRING,MFS_ENABLED
        MENUITEM "应用金手指(&A)",               ID_CHEAT_APPLY,MFT_STRING,MFS_CHECKED
    END
    POPUP "联机(&N)",                       0,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "连接到服务器...(&C)",       ID_NETPLAY_CONNECT,MFT_STRING,MFS_ENABLED
        MENUITEM "断开与服务器的连接(&D)",     ID_NETPLAY_DISCONNECT,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "作为服务器(&A)",              ID_NETPLAY_SERVER,MFT_STRING,MFS_ENABLED
        MENUITEM "立即使用冻结文件重新同步所有客户端(&R)", ID_NETPLAY_SYNC,MFT_STRING,MFS_ENABLED
        MENUITEM "立即向客户端发送 ROM 镜像(&S)", ID_NETPLAY_ROM,MFT_STRING,MFS_ENABLED
        MENUITEM "连接时向客户端发送 ROM 镜像(&D)",  ID_NETPLAY_SEND_ROM_ON_CONNECT,MFT_STRING,MFS_ENABLED
        MENUITEM "通过重置游戏同步(&Y)",      ID_NETPLAY_SYNC_BY_RESET,MFT_STRING,MFS_CHECKED
        MENUITEM MFT_SEPARATOR
        MENUITEM "选项...(&O)",                 ID_NETPLAY_OPTIONS,MFT_STRING,MFS_ENABLED
    END
    POPUP "帮助(&H)",                          0,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "关于...(&A)",                   ID_HELP_ABOUT,MFT_STRING,MFS_ENABLED
    END
END


